                                    <th>Qualification Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Under 60 seconds</td><td style="color:#10b981;font-weight:700;">93%</td><td style="color:#10b981;font-weight:700;">Highest</td></tr>
